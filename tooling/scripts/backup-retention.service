[Unit]
Description=OpenSIN Chat backup retention cleanup
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/etc/opensin-chat/backup.env
ExecStart=/usr/local/libexec/opensin-chat/backup-retention
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opensin-chat/backups
