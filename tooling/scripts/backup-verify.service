[Unit]
Description=OpenSIN Chat backup verification
After=network.target

[Service]
Type=oneshot
EnvironmentFile=/etc/opensin-chat/backup.env
ExecStart=/usr/local/libexec/opensin-chat/verify-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/opensin-chat/data
ReadWritePaths=/var/lib/opensin-chat/backups
