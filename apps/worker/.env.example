# Placeholder .env file for collector runtime

# Port the collector listens on. The server must use the same COLLECTOR_PORT value when running services separately.
# COLLECTOR_PORT=8888

# Root storage directory for documents, uploads, and tmp files.
# In Docker this is typically /app/server/storage.
# In development the API falls back to <repo>/apps/api/storage if unset.
# STORAGE_DIR=/app/server/storage

# This enables HTTP request/response logging in development. Set value to truthy string to enable, leave empty value or comment out to disable
# ENABLE_HTTP_LOGGER=""
# This enables timestamps for the HTTP Logger. Set value to true to enable, leave empty or comment out to disable
# ENABLE_HTTP_LOGGER_TIMESTAMPS=""

###########################################
########## OCR (PDF TEXT EXTRACTION) ######
###########################################
# OCR engine for scanned PDFs: "auto" (default), "unlimited", "nim", or "tesseract".
# Auto uses configured Unlimited-OCR, then NVIDIA NIM, then Tesseract.
# OCR_ENGINE=auto

# Timeout (ms) for OCR processing a single PDF page. Default: 600000 (10 min).
# OCR_TIMEOUT_MS=600000

# Bootstrap timeout (ms) for the OCR worker process before it is killed. Default: 30000.
# OCR_WORKER_BOOTSTRAP_TIMEOUT_MS=30000

# Ratio (0.0–1.0) of pages that must return OCR text before the result replaces the native PDF text layer.
# A higher value makes OCR less aggressive. Default: 0.5
# PDF_OCR_MERGE_RATIO=0.5

# --- Baidu Unlimited-OCR (OCR_ENGINE=unlimited) ---
# Inference backend: "vllm" (default, official Docker image) or "sglang".
# UNLIMITED_OCR_BACKEND=vllm
# OpenAI-compatible endpoint. Defaults: vLLM=http://127.0.0.1:8000/v1, SGLang=http://127.0.0.1:10000/v1
# UNLIMITED_OCR_BASE_URL=http://127.0.0.1:8000/v1
# Probe the backend default URL in auto mode even when BASE_URL is unset.
# UNLIMITED_OCR_AUTO_DISCOVER=false
# Served model name. Defaults: vLLM=baidu/Unlimited-OCR, SGLang=Unlimited-OCR
# UNLIMITED_OCR_MODEL=baidu/Unlimited-OCR
# Optional bearer token when the endpoint is behind an authenticated gateway.
# UNLIMITED_OCR_API_KEY=
# Request timeout in ms. Default: 1200000 (20 min)
# UNLIMITED_OCR_TIMEOUT_MS=1200000
# Maximum output tokens. Official vLLM recipe/default: 8192
# UNLIMITED_OCR_MAX_TOKENS=8192
# Number of PDF pages sent in one multi-page request. Default: 8
# UNLIMITED_OCR_PAGES_PER_REQUEST=8
# Full-page PDF rasterization DPI. Upstream reference uses 300. Default: 300
# UNLIMITED_OCR_PDF_DPI=300
# Timeout for pdftoppm PDF rendering. Default: 300000
# UNLIMITED_OCR_RENDER_TIMEOUT_MS=300000
# Optional SGLang-only DeepseekOCRNoRepeatNGramLogitProcessor.to_str() value.
# UNLIMITED_OCR_CUSTOM_LOGIT_PROCESSOR=
# Optional JSON merged over the backend-specific request fields.
# vLLM example: {"skip_special_tokens":false,"vllm_xargs":{"ngram_size":35,"window_size":1024}}
# SGLang example: {"skip_special_tokens":false,"images_config":{"image_mode":"base"},"custom_params":{"ngram_size":35,"window_size":1024}}
# UNLIMITED_OCR_EXTRA_BODY=

# --- Tesseract (OCR_ENGINE=tesseract) ---
# Path to the Tesseract binary. Default: system PATH lookup.
# OCR_CORE_PATH=/usr/bin/tesseract
# Path to Tesseract language data files (.traineddata).
# OCR_TESSDATA_PATH=/usr/share/tesseract-ocr/5/tessdata

# --- NVIDIA NIM (OCR_ENGINE=nim) ---
# NIM API base URL. Default: https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM model for OCR. Default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NIM API key. Required when using the NIM OCR engine.
# NVIDIA_NIM_API_KEY=
# Maximum tokens to request per NIM completion. Default: 4096
# NVIDIA_NIM_MAX_TOKENS=4096
# Request timeout (ms) per NIM call. Default: 120000
# NVIDIA_NIM_TIMEOUT_MS=120000
# Number of concurrent NIM requests when OCR-ing a multi-page PDF. Default: 4
# NVIDIA_NIM_CONCURRENCY=4

###########################################
########## BROWSER / WEB SCRAPING #########
###########################################
# Maximum time (ms) to wait when acquiring a Playwright browser from the pool. Default: 30000
# BROWSER_POOL_ACQUIRE_TIMEOUT_MS=30000

# Set to "true" to allow the dev integrity bypass header (X-Sin-Dev-Bypass).
# Must never be enabled in production.
# SIN_ALLOW_INSECURE_DEV_BYPASS=false

###########################################
########## DOCLING PDF PARSING (OPTIONAL) #
###########################################
# When set, PDFLoader will first try Docling for layout-aware parsing.
# Docling uses a vision model to understand column layouts, tables, and
# headings — significantly better for German Drucksachen / Plenarprotokolle
# than the default pdf.js text extraction.
#
# To start a separately configured Docling service, use its deployment definition.
# Then set this variable to http://localhost:5001 (or http://docling:5001 in Docker).
# Leave empty or unset to use the default pdf.js parser.
# DOCLING_ENDPOINT=

###########################################
########## BUNDESTAG DIP API ##############
###########################################
# API key for the German Bundestag DIP document search API.
# A public demo key is used as fallback but will hit rate limits quickly.
# BUNDESTAG_DIP_API_KEY=
