{
  "name": "opensin-chat",
  "version": "1.15.0",
  "description": "OpenSIN Chat — self-hosted AI workspace for chat, retrieval, document analysis, agents, and controlled integrations.",
  "type": "module",
  "author": "OpenSIN-AI",
  "contributors": [
    {
      "name": "Mintplex Labs Inc.",
      "email": "team@mintplexlabs.com",
      "url": "https://github.com/Mintplex-Labs/anything-llm",
      "role": "Original Upstream Author (AnythingLLM)"
    },
    {
      "name": "Timothy Carambat",
      "url": "https://github.com/TimothyCarambat",
      "role": "Original Creator of AnythingLLM"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/OpenSIN-AI"
  },
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/@prisma/client",
      "**/@prisma/client/**",
      "**/prisma",
      "**/prisma/**"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSIN-AI/OpenSIN-Chat.git"
  },
  "bugs": {
    "url": "https://github.com/OpenSIN-AI/OpenSIN-Chat/issues"
  },
  "homepage": "https://sinchat.delqhi.com",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev:api": "yarn workspace opensin-chat-server dev",
    "dev:web": "yarn workspace opensin-chat-frontend dev",
    "dev:worker": "yarn workspace opensin-chat-document-collector dev",
    "dev": "concurrently -k -n api,web,worker \"yarn dev:api\" \"yarn dev:web\" \"yarn dev:worker\"",
    "build:api": "yarn workspace opensin-chat-server prisma:generate",
    "migrate:api": "yarn workspace opensin-chat-server prisma:migrate",
    "build:web": "yarn workspace opensin-chat-frontend build",
    "build": "yarn build:api && yarn build:web",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:web": "yarn workspace opensin-chat-frontend lint:check",
    "lint:api": "yarn workspace opensin-chat-server lint:check",
    "lint:worker": "yarn workspace opensin-chat-document-collector lint:check",
    "lint:ci": "yarn lint:web && yarn lint:api && yarn lint:worker",
    "test:api": "yarn workspace opensin-chat-server test",
    "test:web": "yarn workspace opensin-chat-frontend test",
    "test:worker": "yarn workspace opensin-chat-document-collector test",
    "test:integration": "node tooling/scripts/run-integration-tests.mjs",
    "test:e2e": "yarn workspace opensin-chat-frontend e2e",
    "test:e2e:smoke": "yarn workspace opensin-chat-frontend e2e:smoke",
    "test:coverage": "yarn workspace opensin-chat-server test:coverage && yarn workspace opensin-chat-frontend test:coverage && yarn workspace opensin-chat-document-collector test:coverage",
    "test": "yarn test:api && yarn test:web && yarn test:worker && yarn test:integration",
    "test:maintenance": "node --test tooling/scripts/*.test.cjs tooling/scripts/*.test.mjs",
    "type-check": "yarn workspace opensin-chat-frontend type-check && yarn workspace opensin-chat-server type-check",
    "verify:translations": "yarn workspace opensin-chat-frontend verify:translations",
    "check:layout": "node tooling/scripts/check-repository-layout.cjs",
    "check:branding": "bash tooling/scripts/check-branding.sh",
    "check:spdx": "node tooling/scripts/spdx-headers.cjs --check",
    "check:public-ops": "node tooling/scripts/check-public-operations.mjs",
    "check:dependencies": "node tooling/scripts/dependency-health.cjs --check",
    "verify": "yarn check:layout && yarn check:branding && yarn check:public-ops && yarn lint:ci && yarn verify:translations && yarn test && yarn build",
    "verify:strict": "yarn verify && yarn type-check && yarn test:coverage",
    "smoke": "node tooling/scripts/smoke.mjs",
    "ocr:unlimited:check": "node tooling/scripts/check-unlimited-ocr.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "playwright": "^1.60.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "eslint": "9.39.2"
  },
  "resolutions": {
    "js-yaml": ">=4.2.0",
    "string-length/strip-ansi": "6.0.1"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "@prisma/client": "^7.8.0",
    "@supabase/storage-js": "^2.110.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "check-disk-space": "^3.4.0",
    "cliui": "8.0.1",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "multer": "^2.2.0",
    "openai": "^6.44.0",
    "pdf-parse": "^2.4.5",
    "slugify": "^1.6.9",
    "string-width": "4.2.3",
    "strip-ansi": "6.0.1",
    "uuid": "^14.0.1",
    "wrap-ansi": "7.0.0"
  }
}
